/* @8spine-meta
 * type: MODULE
 * category: music
 * featured: false
 * trusted: true
 * nsfw: false
 */

const LOG_PREFIX = '[JioSaavn]';
const API_BASE = 'https://cyberboysumanjay.github.io/JioSaavnAPI'; 

// ---------------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------------
async function searchTracks(query, limit = 20) {
    try {
        const response = await fetch(`${API_BASE}/result/?query=${encodeURIComponent(query)}`);
        if (!response.ok) return { tracks: [], total: 0 };
        
        const data = await response.json();
        
        let rawTracks = [];
        if (Array.isArray(data)) rawTracks = data;
        else if (data && data.songs) rawTracks = data.songs;
        else if (typeof data === 'object') rawTracks = [data];

        const tracks = rawTracks.slice(0, limit).map(song => ({
            // CRITICAL: Force IDs to be Strings so 8SPINE doesn't crash
            id: String(song.perma_url || song.id || song.songid),
            title: song.title || song.song || 'Unknown Title',
            artist: song.singers || song.primary_artists || 'Unknown Artist',
            album: song.album || 'Unknown Album',
            albumCover: song.image || song.image_url || '',
            duration: parseInt(song.duration) || 0,
            audioQuality: 'HIGH'
        }));

        return { tracks, total: tracks.length };
    } catch (error) {
        console.warn(LOG_PREFIX, 'Search error:', error);
        return { tracks: [], total: 0 }; // Graceful fail, no UI freeze
    }
}

// ---------------------------------------------------------------------------
// Player Stream
// ---------------------------------------------------------------------------
async function getTrackStreamUrl(trackId, preferredQuality, context) {
    try {
        const response = await fetch(`${API_BASE}/song/?query=${encodeURIComponent(trackId)}`);
        if (!response.ok) throw new Error('HTTP ' + response.status);
        
        const data = await response.json();
        const songData = Array.isArray(data) ? data[0] : data;
        
        const directUrl = songData.media_url || songData.url;

        if (directUrl) {
            return {
                streamUrl: directUrl,
                track: { 
                    id: String(trackId), 
                    audioQuality: 'HIGH'
                }
            };
        }
        throw new Error('No audio found');
    } catch (error) {
        console.warn(LOG_PREFIX, 'Stream error:', error);
        throw error; // Let 8SPINE handle the stream failure natively
    }
}

// ---------------------------------------------------------------------------
// Album Fallback
// ---------------------------------------------------------------------------
async function getAlbum(albumId) {
    throw new Error('Album fetch not supported');
}

// ---------------------------------------------------------------------------
// Module export (Matching Jimmy's exact structure)
// ---------------------------------------------------------------------------
return {
    id: 'jiosaavn',
    name: 'JioSaavn',
    author: 'community',
    version: '1.0.1',
    labels: ['JioSaavn', 'Bollywood', 'Audio'],
    description: 'Stream from JioSaavn via custom API.',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/3/35/JioSaavn-logo.png',

    // Dummy settings to prevent UI crashes if the user opens the module settings
    settings: {
        quality: {
            type: 'selector',
            label: 'Audio Quality',
            description: 'JioSaavn stream quality',
            options: [
                { label: 'High Quality', value: 'HIGH' }
            ],
            defaultValue: 'HIGH'
        }
    },

    searchTracks: searchTracks,
    getTrackStreamUrl: getTrackStreamUrl,
    getAlbum: getAlbum
};
